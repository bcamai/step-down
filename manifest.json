{
  "manifest_version": 3,
  "name": "Mindful Browser",
  "version": "1.0",
  "description": "Blokuje pożeracze czasu, prosi o głęboki oddech i śledzi czas sesji.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "notifications",
    "alarms",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Ustawienia Mindful Browser",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
